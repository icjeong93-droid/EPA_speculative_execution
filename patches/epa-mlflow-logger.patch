+        self._mlflow = False
+        self._fails = 0
+        self._epoch = {}
+        self._start_mlflow(cfg)
+
+    # --- mlflow ----------------------------------------------------------
+    def _start_mlflow(self, cfg):
+        if not (_MLFLOW_AVAILABLE and cfg is not None):
+            return
+        mlcfg = _cfg_get(cfg, "mlflow")
+        if not _cfg_get(mlcfg, "use_mlflow", False):
+            return
+        try:
+            uri = os.environ.get("EPA_MLFLOW_URI") or _cfg_get(mlcfg, "tracking_uri")
+            if uri:
+                if str(uri).startswith("file:") or "://" not in str(uri):
+                    # MLflow >= 3.5 refuses the filesystem backend unless this is
+                    # set. We do want it here: five runs log concurrently and the
+                    # file store gives each its own directory, where a single
+                    # sqlite file would serialise them and raise "database is
+                    # locked" under four H100s.
+                    os.environ.setdefault("MLFLOW_ALLOW_FILE_STORE", "true")
+                mlflow.set_tracking_uri(uri)
+            name = _cfg_get(mlcfg, "experiment_name", "EPA")
+            # launch_train.sh starts one process per GPU at the same instant, so
+            # several of them can try to create the experiment directory at once.
+            for attempt in range(3):
+                try:
+                    mlflow.set_experiment(name)
+                    break
+                except Exception:
+                    if attempt == 2:
+                        raise
+                    time.sleep(1.0 + attempt)
+            mlflow.start_run(run_name=_cfg_get(cfg, "run_name"))
+            self._mlflow = True
+            self._log_params(cfg)
+        except Exception as e:
+            print(f"[mlflow] disabled: {type(e).__name__}: {e}", flush=True)
+            self._mlflow = False
+
+    def _log_params(self, cfg):
+        try:
+            params = self._flatten(cfg)
+            if params:
+                mlflow.log_params(params)
+        except Exception:
+            self._quiet()
+
+    def _flatten(self, node, prefix="", out=None, depth=0):
+        if out is None:
+            out = {}
+        if depth > 3 or len(out) > 90:      # mlflow caps params per run
+            return out
+        try:
+            items = list(node.items())
+        except Exception:
+            return out
+        for key, val in items:
+            full = f"{prefix}{key}"
+            if hasattr(val, "items"):
+                self._flatten(val, full + ".", out, depth + 1)
+            elif isinstance(val, (str, int, float, bool, list, tuple)) or val is None:
+                text = str(val)
+                if len(text) <= 250:
+                    out[full] = text
+        return out
+
+    def _quiet(self):
+        self._fails += 1
+        if self._fails == 3:
+            print("[mlflow] repeated logging failures; continuing without it",
+                  flush=True)
+            self._mlflow = False
+
