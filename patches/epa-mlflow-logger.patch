+import os
+import time
 import wandb
 import matplotlib.pyplot as plt
 
+# --- MLflow (patches/epa-mlflow-logger.patch) -----------------------------
+# Metrics go to MLflow, not wandb. Upstream hardwires wandb's mode to "online"
+# whenever use_wandb is true (see __init__ below), and the HPC has no network,
+# so wandb stays disabled and MLflow carries the run.
+#
+# MLflow writes to a local FILE STORE -- tracking_uri is file:///<workdir>/logs/
+# mlruns -- which needs no server and no network. The directory is copied out
+# afterwards and opened with `mlflow ui` on a machine that has a browser.
+#
+# EVERY mlflow call is guarded. A training run is 8+ hours; it must never die
+# because a logger failed. On repeated failures we print once and go quiet.
+try:
+    import mlflow
+    _MLFLOW_AVAILABLE = True
+except Exception:
+    _MLFLOW_AVAILABLE = False
+
+
+def _cfg_get(node, key, default=None):
+    """Read a key off an easydict/dict/namespace without raising."""
+    if node is None:
+        return default
+    try:
+        val = getattr(node, key)
+    except (AttributeError, KeyError, TypeError):
+        try:
+            val = node[key]
+        except Exception:
+            return default
+    return default if val is None else val
+
+
 class WandbLogger():
     def __init__(self, cfg):
         self.cfg = cfg
